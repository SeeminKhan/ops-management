# Supabase Setup Configuration
# IMPORTANT: This file requires the SERVICE ROLE KEY for admin operations
# Copy this file to .env.setup and add your actual credentials
# NEVER commit .env.setup to version control

# Your Supabase project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase SERVICE ROLE KEY (NOT the anon key!)
# Get this from: Supabase Dashboard → Settings → API → service_role key
# This key has admin privileges - keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
